# Search narrows the Message List as the Query is typed, and its menu
# completes each operator's value.
Output landing/public/media/search.mp4
Output landing/public/media/search.webm
Source demo/tapes/setup.tape

Show
Sleep 1s
Type "/"
Sleep 600ms
Set TypingSpeed 220ms
Type "is:u"
Sleep 900ms
Tab
Sleep 1.5s
Type " has:a"
Sleep 900ms
Tab
Sleep 1.2s
Escape
Sleep 2.5s
