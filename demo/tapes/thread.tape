# Opening a Thread and reading it: the stack of earlier Messages unfolds,
# then the first one opens in full.
Output landing/public/media/thread.mp4
Output landing/public/media/thread.webm
Source demo/tapes/setup.tape

Type "gj"
Sleep 500ms
Show
Sleep 1s
Enter
Sleep 1.5s
Type "p"
Sleep 600ms
Enter
Sleep 1.5s
Type "p"
Sleep 600ms
Enter
Sleep 2.5s
