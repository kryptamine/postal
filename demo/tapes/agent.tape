# The agent pane beside a Draft: asked to tidy a Reply, its edit lands in
# the buffer, reviewed hunk by hunk.
Output landing/public/media/agent.mp4
Output landing/public/media/agent.webm
Source demo/tapes/setup.tape

Type "gjr"
Sleep 2s
Type "5GI"
Type "hi maya,"
Enter
Enter
Type "i land 14:30 on the 9th, will get the train. save me a seat at dinner?"
Enter
Enter
Type "sam"
Enter
Escape
Type "gg"
Sleep 300ms
Show
Sleep 700ms
Type ":PostalAgent"
Enter
Sleep 900ms
Type "imake it friendlier"
Escape
Enter
Sleep 2.2s
Ctrl+W
Type "h5G"
Sleep 500ms
Type "\a"
Sleep 1s
Type "7G"
Sleep 400ms
Type "\a"
Sleep 1s
Type "\A"
Sleep 1.5s
