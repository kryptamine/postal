#!/bin/sh
# Stands in for `postal` in `make smoke`: `thread show` gives a Thread,
# anything else the Correspondents tests/nvim.rs gives the real one.
if [ "$1 $2" = "thread show" ]; then
	printf '%s\n' 'From: Bob <bob@example.com>' 'Recipients: me@example.com' 'Date: 2024-11-18 09:00' '' 'Shall we meet?'
	exit 0
fi

printf '%s\n' '[{"address":"petr@example.com","name":"Petr Novak","mailbox":"Petr Novak <petr@example.com>","account":"me@example.com","written":false},{"address":"pan@example.com","name":"Peter Pan","mailbox":"Peter Pan <pan@example.com>","account":"me@example.com","written":false},{"address":"ada@example.com","name":"Ada Lovelace","mailbox":"Ada Lovelace <ada@example.com>","account":"me@example.com","written":false}]'
