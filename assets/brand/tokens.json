{
  "$description": "Postal design tokens. Source of truth for tokens.css; docs/brand-guidelines.md explains each choice.",
  "primitive": {
    "color": {
      "paper": { "$type": "color", "$value": "#F4EFE6" },
      "paper-deep": { "$type": "color", "$value": "#EBE4D7" },
      "paper-rule": { "$type": "color", "$value": "#D6CCBB" },
      "ink": { "$type": "color", "$value": "#1C1B19" },
      "ink-soft": { "$type": "color", "$value": "#5E5A53" },
      "graphite": { "$type": "color", "$value": "#171614" },
      "graphite-raised": { "$type": "color", "$value": "#22201D" },
      "graphite-rule": { "$type": "color", "$value": "#3A3733" },
      "chalk": { "$type": "color", "$value": "#ECE6DA" },
      "chalk-soft": { "$type": "color", "$value": "#A39D92" },
      "postbox-red": { "$type": "color", "$value": "#B5361F" },
      "postbox-red-deep": { "$type": "color", "$value": "#9A2D19" },
      "postbox-red-night": { "$type": "color", "$value": "#F0674A" },
      "postbox-red-night-bright": { "$type": "color", "$value": "#F5836A" },
      "airmail-blue": { "$type": "color", "$value": "#2B4C9B" },
      "airmail-blue-night": { "$type": "color", "$value": "#8FA9F0" },
      "stamp-ochre": { "$type": "color", "$value": "#C99A2E" },
      "stamp-ochre-deep": { "$type": "color", "$value": "#8A6414" },
      "stamp-ochre-night": { "$type": "color", "$value": "#E0B04F" },
      "fern": { "$type": "color", "$value": "#2F6B45" },
      "fern-night": { "$type": "color", "$value": "#7CC495" }
    },
    "font": {
      "grotesk": { "$type": "fontFamily", "$value": "'Schibsted Grotesk', system-ui, -apple-system, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace" }
    },
    "cell": { "$type": "dimension", "$value": "8px" }
  },

  "semantic": {
    "color": {
      "bg": { "$type": "color", "$value": "{primitive.color.paper}" },
      "surface": { "$type": "color", "$value": "{primitive.color.paper-deep}" },
      "rule": { "$type": "color", "$value": "{primitive.color.paper-rule}" },
      "text": { "$type": "color", "$value": "{primitive.color.ink}" },
      "text-muted": { "$type": "color", "$value": "{primitive.color.ink-soft}" },
      "primary": { "$type": "color", "$value": "{primitive.color.postbox-red}" },
      "primary-hover": { "$type": "color", "$value": "{primitive.color.postbox-red-deep}" },
      "on-primary": { "$type": "color", "$value": "{primitive.color.paper}" },
      "secondary": { "$type": "color", "$value": "{primitive.color.airmail-blue}" },
      "accent": { "$type": "color", "$value": "{primitive.color.stamp-ochre}" },
      "focus": { "$type": "color", "$value": "{primitive.color.airmail-blue}" },
      "success": { "$type": "color", "$value": "{primitive.color.fern}" },
      "warning": { "$type": "color", "$value": "{primitive.color.stamp-ochre-deep}" },
      "error": { "$type": "color", "$value": "{primitive.color.postbox-red}" },
      "info": { "$type": "color", "$value": "{primitive.color.airmail-blue}" }
    },
    "font": {
      "heading": { "$type": "fontFamily", "$value": "{primitive.font.grotesk}" },
      "prose": { "$type": "fontFamily", "$value": "{primitive.font.grotesk}" },
      "ui": { "$type": "fontFamily", "$value": "{primitive.font.mono}" },
      "code": { "$type": "fontFamily", "$value": "{primitive.font.mono}" }
    },
    "text": {
      "display": { "$type": "dimension", "$value": "clamp(2.5rem, 1.6rem + 3.6vw, 4rem)" },
      "h1": { "$type": "dimension", "$value": "clamp(2rem, 1.4rem + 2.4vw, 3rem)" },
      "h2": { "$type": "dimension", "$value": "clamp(1.625rem, 1.4rem + 0.9vw, 2rem)" },
      "h3": { "$type": "dimension", "$value": "clamp(1.25rem, 1.2rem + 0.2vw, 1.375rem)" },
      "prose": { "$type": "dimension", "$value": "clamp(1.0625rem, 1rem + 0.25vw, 1.125rem)" },
      "ui": { "$type": "dimension", "$value": "0.9375rem" },
      "caption": { "$type": "dimension", "$value": "0.8125rem" }
    },
    "weight": {
      "display": { "$type": "fontWeight", "$value": "800" },
      "heading": { "$type": "fontWeight", "$value": "700" },
      "subheading": { "$type": "fontWeight", "$value": "600" },
      "ui-strong": { "$type": "fontWeight", "$value": "500" },
      "body": { "$type": "fontWeight", "$value": "400" }
    },
    "leading": {
      "display": { "$type": "number", "$value": "1.05" },
      "heading": { "$type": "number", "$value": "1.15" },
      "body": { "$type": "number", "$value": "1.6" }
    },
    "tracking": {
      "heading": { "$type": "dimension", "$value": "-0.02em" },
      "label": { "$type": "dimension", "$value": "0.08em" }
    },
    "measure": { "$type": "dimension", "$value": "68ch" },
    "space": {
      "half": { "$type": "dimension", "$value": "calc({primitive.cell} / 2)" },
      "1": { "$type": "dimension", "$value": "{primitive.cell}" },
      "2": { "$type": "dimension", "$value": "calc({primitive.cell} * 2)" },
      "3": { "$type": "dimension", "$value": "calc({primitive.cell} * 3)" },
      "4": { "$type": "dimension", "$value": "calc({primitive.cell} * 4)" },
      "6": { "$type": "dimension", "$value": "calc({primitive.cell} * 6)" },
      "8": { "$type": "dimension", "$value": "calc({primitive.cell} * 8)" },
      "12": { "$type": "dimension", "$value": "calc({primitive.cell} * 12)" }
    },
    "radius": {
      "control": { "$type": "dimension", "$value": "4px" },
      "card": { "$type": "dimension", "$value": "6px" },
      "pill": { "$type": "dimension", "$value": "9999px" }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "ease": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "dark": {
    "semantic": {
      "color": {
        "bg": { "$type": "color", "$value": "{primitive.color.graphite}" },
        "surface": { "$type": "color", "$value": "{primitive.color.graphite-raised}" },
        "rule": { "$type": "color", "$value": "{primitive.color.graphite-rule}" },
        "text": { "$type": "color", "$value": "{primitive.color.chalk}" },
        "text-muted": { "$type": "color", "$value": "{primitive.color.chalk-soft}" },
        "primary": { "$type": "color", "$value": "{primitive.color.postbox-red-night}" },
        "primary-hover": { "$type": "color", "$value": "{primitive.color.postbox-red-night-bright}" },
        "on-primary": { "$type": "color", "$value": "{primitive.color.graphite}" },
        "secondary": { "$type": "color", "$value": "{primitive.color.airmail-blue-night}" },
        "accent": { "$type": "color", "$value": "{primitive.color.stamp-ochre-night}" },
        "focus": { "$type": "color", "$value": "{primitive.color.airmail-blue-night}" },
        "success": { "$type": "color", "$value": "{primitive.color.fern-night}" },
        "warning": { "$type": "color", "$value": "{primitive.color.stamp-ochre-night}" },
        "error": { "$type": "color", "$value": "{primitive.color.postbox-red-night}" },
        "info": { "$type": "color", "$value": "{primitive.color.airmail-blue-night}" }
      }
    }
  },

  "component": {
    "button": {
      "primary-bg": { "$type": "color", "$value": "{semantic.color.primary}" },
      "primary-bg-hover": { "$type": "color", "$value": "{semantic.color.primary-hover}" },
      "primary-fg": { "$type": "color", "$value": "{semantic.color.on-primary}" },
      "secondary-fg": { "$type": "color", "$value": "{semantic.color.text}" },
      "secondary-border": { "$type": "color", "$value": "{semantic.color.rule}" },
      "secondary-border-hover": { "$type": "color", "$value": "{semantic.color.text}" },
      "font": { "$type": "fontFamily", "$value": "{semantic.font.ui}" },
      "weight": { "$type": "fontWeight", "$value": "{semantic.weight.ui-strong}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" },
      "padding": { "$type": "dimension", "$value": "calc({primitive.cell} * 1.25) calc({primitive.cell} * 2.25)" }
    },
    "link": {
      "fg": { "$type": "color", "$value": "{semantic.color.primary}" },
      "fg-hover": { "$type": "color", "$value": "{semantic.color.primary-hover}" }
    },
    "focus": {
      "ring": { "$type": "border", "$value": "2px solid {semantic.color.focus}" },
      "offset": { "$type": "dimension", "$value": "2px" }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.card}" },
      "padding": { "$type": "dimension", "$value": "{semantic.space.3}" }
    },
    "code": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "border": { "$type": "color", "$value": "{semantic.color.rule}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" }
    },
    "kbd": {
      "bg": { "$type": "color", "$value": "{semantic.color.bg}" },
      "border": { "$type": "color", "$value": "{semantic.color.rule}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.pill}" }
    },
    "media": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.card}" },
      "perforation": { "$type": "dimension", "$value": "7px" }
    },
    "airmail": {
      "red": { "$type": "color", "$value": "{semantic.color.primary}" },
      "blue": { "$type": "color", "$value": "{semantic.color.secondary}" },
      "band": { "$type": "dimension", "$value": "10px" }
    },
    "postmark": {
      "fg": { "$type": "color", "$value": "{semantic.color.primary}" }
    }
  },

  "$contrast": {
    "$description": "Pairs scripts/tokens.py checks in both themes: [foreground, background, minimum ratio].",
    "pairs": [
      ["text", "bg", 7],
      ["text", "surface", 7],
      ["text-muted", "bg", 4.5],
      ["text-muted", "surface", 4.5],
      ["primary", "bg", 4.5],
      ["primary", "surface", 4.5],
      ["primary-hover", "bg", 4.5],
      ["on-primary", "primary", 4.5],
      ["on-primary", "primary-hover", 4.5],
      ["secondary", "bg", 4.5],
      ["secondary", "surface", 4.5],
      ["success", "bg", 4.5],
      ["warning", "bg", 4.5],
      ["error", "bg", 4.5],
      ["focus", "bg", 3]
    ]
  }
}
