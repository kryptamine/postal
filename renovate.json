{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "One PR a week for the non-major Rust updates",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "Rust non-major"
    },
    {
      "description": "One PR a week for the non-major landing updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "landing non-major"
    },
    {
      "description": "One PR a week for the non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "GitHub Actions non-major"
    },
    {
      "description": "typescript-eslint does not support TypeScript 7 yet",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
