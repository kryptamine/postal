---
import { site } from '@app/site';
import Base from '@app/layouts/Base.astro';
import hero from '@app/assets/media/hero.png';
import Copy from '@app/components/Copy.astro';
import Media from '@app/components/Media.astro';
import thread from '@app/assets/media/thread.png';
import browser from '@app/assets/media/browser.png';
import Airmail from '@app/components/Airmail.astro';
import Feature from '@app/components/Feature.astro';
import rendered from '@app/assets/media/rendered.png';
import Postmark from '@app/components/Postmark.astro';
import onboarding from '@app/assets/media/onboarding.png';

const budget = [
  ['≤100 ms', 'From launch to the message list, read from the local cache'],
  ['≤16 ms', 'From a keypress to the redrawn screen: scrolling, selecting, typing a search'],
  ['≤30 MB', 'Memory in use after scrolling through the whole list'],
  ['≤500 ms', 'From a new message reaching the server to its row on your screen'],
];

// Each description is HTML, for the keys and commands it names.
const also = [
  ['All inboxes', 'The inboxes of all your accounts in one list, newest first.'],
  [
    'Undo',
    '<kbd>u</kbd> undoes a delete, an archive, a move or a discarded draft, and for ten seconds a sent message.',
  ],
  [
    'Act on several at once',
    '<kbd>J</kbd> and <kbd>K</kbd> pick a run of threads to delete, archive or move together. One <kbd>u</kbd> brings them all back.',
  ],
  [
    'Archive and move',
    '<kbd>e</kbd> archives a message. <kbd>m</kbd> moves it to a folder you find by typing.',
  ],
  [
    'Meeting invitations',
    'An invitation shows as a card: when, in your time zone and the event’s, where, and the link to join.',
  ],
  [
    'Open in the browser',
    '<kbd>B</kbd> opens an HTML mail in your browser, to see it exactly as it was sent.',
  ],
  ['Attachments', 'Open or save an attachment by typing its label, no mouse needed.'],
  [
    'Check now',
    '<kbd>^r</kbd> fetches new mail on every account at once, without waiting for the server.',
  ],
  ['Notifications', 'A desktop notification for new mail while the terminal is in the background.'],
  [
    'Mail links',
    '<code>postal setup-mailto</code> makes Postal the handler of <code>mailto:</code> links: a click in the browser opens a new draft in a terminal.',
  ],
  ['Works offline', 'Your mail loads from the local cache before the server answers.'],
  [
    'Mail for your agents',
    '<code>postal mcp</code> serves your cached mail to any MCP client: folders, threads, messages, search and a sync. It never sends, moves or deletes.',
  ],
];

const install = `curl -fsSL ${site.url}/install.sh | sh`;

// schema.org's description of the app, for search engines that read JSON-LD.
const app = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description: site.description,
  url: `${site.url}/`,
  applicationCategory: 'CommunicationApplication',
  operatingSystem: 'macOS, Linux',
  license: 'https://opensource.org/license/mit',
  downloadUrl: `${site.url}/install.sh`,
  sameAs: [site.repo],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const providers = [
  [
    'Google',
    'Gmail. You sign in through the browser, and Postal stores a token, never your password.',
  ],
  ['iCloud', 'Sign in with an app-specific password.'],
  [
    'Any IMAP server',
    'Enter your email address, and Postal looks up the servers your domain publishes.',
  ],
];
---

<Base>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(app)} />
  <section class="hero wrap">
    <div class="pitch">
      <!-- The eyebrow sits in the h1, so the heading names what Postal is. -->
      <h1>
        <span class="eyebrow">A mail client for the terminal</span>
        Mail at <span class="accent">terminal speed.</span>
      </h1>
      <p class="lede prose-font">
        Gmail, iCloud and any IMAP server in one keyboard-driven window. HTML mail keeps its layout,
        the list opens in 100&nbsp;ms from a local copy of your mail, and nothing leaves your
        computer except the mail you send.
      </p>
      <div class="command">
        <pre><code><span class="p">$</span> {install}</code></pre>
        <Copy text={install} />
      </div>
      <p class="muted small">
        Free and MIT-licensed. macOS&nbsp;13+ and Linux, arm64&nbsp;and&nbsp;x86_64.
        <a class="nowrap" href={site.repo}>
          Read the source
        </a>
      </p>
    </div>
    <div class="shot">
      <Media still={hero} shows="The message list next to a preview of an HTML mail" priority />
      <div class="cancel">
        <Postmark value="≤100" unit="MS" rim="POSTAL · COLD START · FROM THE CACHE ·" />
      </div>
    </div>
  </section>

  <section class="problem wrap" aria-labelledby="problem-title">
    <h2 id="problem-title">You left the terminal to read your mail</h2>
    <p class="prose-font muted">
      Mail lives in a browser tab that takes seconds to load and wants the mouse. Terminal clients
      fix the speed, then show a newsletter as a wall of table markup and ask for an evening of
      config before the first message.
    </p>
  </section>

  <section class="budget wrap" aria-labelledby="budget-title">
    <div class="intro">
      <h2 id="budget-title">Speed, in numbers</h2>
      <p class="prose-font muted">
        Postal is built and tested against these targets, with 10,000 messages in the cache. Once it
        is running, drawing a frame allocates no memory.
      </p>
    </div>
    <dl>
      {budget.map(([figure, what]) => (
        <div>
          <dt>{figure}</dt>
          <dd>{what}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="features" class="html wrap" aria-labelledby="html-title">
    <div class="intro">
      <p class="eyebrow">HTML mail</p>
      <h2 id="html-title">Postal reads mail the way a mail client does, in terminal cells</h2>
      <p class="prose-font">
        Postal runs an HTML and CSS layout engine and draws the result in terminal cells. Columns,
        buttons, coloured blocks and borders stay where the sender put them, and the mail's colours
        are adjusted to your terminal's background.
      </p>
    </div>
    <div class="pair">
      <Media still={browser} caption="In a web browser" shows="A newsletter in a web browser" />
      <Media still={rendered} caption="In Postal" shows="The same newsletter in Postal" />
    </div>
    <ul class="points">
      <li>
        <kbd>v</kbd> <span>switches to plain text, in reading order.</span>
      </li>
      <li>
        <kbd>o</kbd> <span>puts a label on every link. Type the label to open the link.</span>
      </li>
      <li>
        <kbd>∅</kbd>
        <span>
          Postal never downloads images, so a sender cannot tell that you opened their mail. Each
          image shows as its name.
        </span>
      </li>
      <li>
        <kbd>B</kbd>
        <span>opens the mail in your browser, images and all, when you choose to see it.</span>
      </li>
    </ul>
  </section>

  <div class="features wrap">
    <Feature
      label="Threads"
      title="Read a whole conversation top to bottom"
      still={thread}
      shows="A thread with its messages stacked and the read ones in the middle folded"
      keys={[
        ['Enter', 'open the thread full screen'],
        ['n p', 'next and previous message'],
        ['|', 'open the message in $PAGER'],
      ]}
    >
      <p>
        A thread opens as one page, oldest message at the top and newest at the bottom. Messages you
        have already read in the middle fold to one line each, and the quoted earlier mail at the
        end of a reply is hidden.
      </p>
      <p>On Gmail, the thread also brings in its messages from other folders.</p>
    </Feature>

    <Feature
      flip
      label="Search"
      title="Search all your mail as you type"
      video="search"
      shows="A search narrowed by is:unread and has:attachment, each completed from a menu"
      keys={[
        ['/', 'start a search'],
        ['Tab', 'complete an operator from the menu'],
        ['Esc', 'close it and stay on the selected message'],
      ]}
    >
      <p>
        Each keystroke narrows the list to the matching threads, best match first. A word matches
        the body of a message too: Postal downloads your folders in the background and indexes them
        on your computer, across every account.
      </p>
      <p>
        Gmail's operators work as well: <code>from:</code>, <code>is:unread</code>,{' '}
        <code>has:attachment</code>, <code>in:</code>, <code>before:</code> and more, with a menu
        that completes names, folders and values. Results appear within a frame, with or without a
        connection.
      </p>
    </Feature>

    <Feature
      label="Compose"
      title="Write in your own editor"
      video="compose"
      shows="A draft in $EDITOR: headers, addresses completing, an Attach: line"
      keys={[
        ['c', 'write a new message'],
        ['r', 'reply'],
        ['u', 'take back a message in the seconds after you send it'],
      ]}
    >
      <p>
        A new message opens in <code>$EDITOR</code> as plain text: <code>To</code>, <code>Cc</code>,{' '}
        <code>Subject</code> and <code>Attach</code> lines, then the body. Addresses complete from
        the people you have exchanged mail with, and on macOS from your Contacts too.
      </p>
      <p>
        Write the body in Markdown if you like: Postal sends its HTML beside the plain text, so
        lists, links and code read well in any client.
      </p>
      <p>
        Sent mail goes through an outbox that keeps retrying until the server accepts it. A draft
        you put aside stays on your computer until you come back to it.
      </p>
    </Feature>

    <Feature
      flip
      label="Neovim"
      title="An AI agent next to your draft"
      video="agent"
      shows="The agent pane next to a draft, with an edit reviewed hunk by hunk"
    >
      <p>
        The Neovim plugin completes addresses as you type, warns of a draft with no recipient or
        subject, or one that mentions an attachment it lacks, and sends it with
        <code>:PostalSend</code> without leaving the editor.
      </p>
      <p>
        It can also open a chat pane with an agent you already use, connected over the Agent Client
        Protocol. Ask it about the message you are reading, or let it edit your draft and review
        each change hunk by hunk.
      </p>
      <p>
        Postal does not include an agent. You bring your own, and it sees a message only when you
        ask it to.
      </p>
    </Feature>

    <Feature
      label="Settings"
      title="Every setting says what it does"
      video="settings"
      shows="Settings in tabs: accounts, icons, notifications, each value with what it does"
      keys={[
        [',', 'open Settings'],
        ['Tab', 'next tab'],
        ['Enter', 'apply the selected value'],
      ]}
    >
      <p>
        Settings opens on <kbd>,</kbd> as a row of tabs: accounts and their signatures, icons,
        notifications, your name and where secrets are kept. Each tab says what it sets, and lists
        every value with what it does.
      </p>
    </Feature>
  </div>

  <section class="also wrap" aria-labelledby="also-title">
    <h2 id="also-title">Also included</h2>
    <dl>
      {also.map(([name, what]) => (
        <div>
          <dt>{name}</dt>
          <dd set:html={what} />
        </div>
      ))}
    </dl>
  </section>

  <section class="local" aria-labelledby="local-title">
    <Airmail />
    <div class="wrap inner">
      <div class="intro">
        <p class="eyebrow">Privacy</p>
        <h2 id="local-title">Your mail stays on your computer</h2>
        <p class="prose-font">
          Postal has no servers of its own. Your mail goes between your computer and your mail
          provider, and nowhere else.
        </p>
        <p>
          <a href="/privacy/">Read the privacy policy</a>
        </p>
      </div>
      <ul>
        <li>
          <strong>Messages</strong> are cached in a SQLite database under
          <code>~/.cache/postal</code>.
        </li>
        <li>
          <strong>Passwords and tokens</strong> go in your system keychain by default.
        </li>
        <li>
          <strong>No telemetry</strong>, analytics or crash reports. The log is a file on your disk.
        </li>
        <li>
          <strong>No images</strong> are downloaded, so tracking pixels never load, unless you open
          a mail in your browser with <kbd>B</kbd>.
        </li>
      </ul>
    </div>
  </section>

  <section class="providers wrap" aria-labelledby="providers-title">
    <div class="intro">
      <h2 id="providers-title">Mail providers and systems</h2>
      <p class="prose-font muted">
        Runs on macOS and Linux, in any modern terminal. You can use several accounts at once.
      </p>
    </div>
    <ul>
      {providers.map(([name, how]) => (
        <li>
          <h3>{name}</h3>
          <p>{how}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="install" class="install wrap" aria-labelledby="install-title">
    <div class="intro">
      <h2 id="install-title">Install</h2>
      <ol class="how prose-font">
        <li>
          <strong>Install.</strong> The script puts one binary in <code>~/.local/bin</code>, on
          macOS or Linux, arm64 or x86_64.
        </li>
        <li>
          <strong>Sign in.</strong> Run <code>postal</code>, pick Google, iCloud or another server,
          and sign in. The token or password goes in your system keychain.
        </li>
        <li>
          <strong>Read.</strong> The inbox loads while the rest of your mail downloads and is
          indexed in the background. Press <kbd>?</kbd> to see every key.
        </li>
      </ol>
      <p class="muted">
        <code>postal update</code> later replaces it with the latest release. The
        <a href={`${site.repo}#neovim`}>Neovim plugin</a> installs through your plugin manager.
      </p>
    </div>
    <div class="steps">
      <div class="command">
        <pre><code><span class="p">$</span> {install}
<span class="p">$</span> postal</code></pre>
        <Copy text={install} />
      </div>
      <Media still={onboarding} shows="The list of mail providers on first run" />
    </div>
  </section>
</Base>

<style>
  section {
    scroll-margin-top: var(--space-4);
  }

  .intro {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  /* Hero */
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-8);
  }

  .pitch {
    display: grid;
    gap: var(--space-3);
    max-width: 46rem;
  }

  .hero h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
  }

  .hero h1 .eyebrow {
    display: block;
    margin-bottom: var(--space-3);
    font: var(--weight-body) var(--text-caption) / var(--leading-body) var(--font-ui);
    letter-spacing: var(--tracking-label);
  }

  .hero h1 .accent {
    color: var(--color-primary);
    white-space: nowrap;
  }

  .shot {
    position: relative;
  }

  /* The postmark cancels the stamp: struck over its corner, a little askew. */
  .cancel {
    position: absolute;
    top: calc(var(--space-6) * -1);
    right: var(--space-3);
    rotate: -11deg;
    background: radial-gradient(circle, var(--color-bg) 68%, transparent 69%);
    border-radius: 50%;
  }

  @media (max-width: 47.99rem) {
    .cancel {
      position: static;
      rotate: -6deg;
      width: fit-content;
      margin: var(--space-2) auto 0;
    }
  }

  /* Budget */
  .budget {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  .budget dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: var(--space-4) var(--space-3);
  }

  .budget dl div {
    display: grid;
    gap: var(--space-half);
    align-content: start;
    padding-top: var(--space-2);
    border-top: 2px solid var(--color-text);
  }

  .budget dt {
    font: var(--weight-display) var(--text-h1) / 1.05 var(--font-heading);
    letter-spacing: var(--tracking-heading);
    font-variant-numeric: tabular-nums;
  }

  .budget dd {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }

  /* HTML mail */
  .html {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-3);
  }

  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-2) var(--space-6);
    padding: 0;
    list-style: none;
    font-size: var(--text-caption);
  }

  .points li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2);
    align-items: baseline;
    color: var(--color-text-muted);
  }

  .points kbd {
    color: var(--color-text);
  }

  /* Feature rows */
  .features {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 60rem) {
    .features {
      gap: var(--space-12);
    }
  }

  /* Also */
  .also {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  .also dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-3) var(--space-4);
  }

  .also dl div {
    display: grid;
    gap: var(--space-half);
    align-content: start;
  }

  .also dt {
    font: var(--weight-subheading) 1.0625rem / 1.3 var(--font-heading);
  }

  .also dd {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }

  /* Local */
  .local {
    background: var(--color-surface);
  }

  .local .inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  @media (min-width: 60rem) {
    .local .inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
      align-items: center;
    }
  }

  .local ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .local li {
    padding-left: var(--space-2);
    border-left: 2px solid var(--color-primary);
    color: var(--color-text-muted);
  }

  .local li strong {
    color: var(--color-text);
    font-weight: var(--weight-ui-strong);
  }

  .local .intro a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .local code {
    background: var(--color-bg);
  }

  /* Providers */
  .providers {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .providers ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .providers li {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--card-padding);
    border-radius: var(--card-radius);
    background: var(--card-bg);
  }

  .providers li p {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }

  /* Install */
  .install {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8) 0;
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 60rem) {
    .install {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
    }
  }

  .steps {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .command {
    position: relative;
  }

  /* Room on the right for the copy button, so the command never runs under it. */
  .command pre {
    padding-right: 6rem;
  }

  pre {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    border: 1px solid var(--code-border);
    border-radius: var(--card-radius);
    background: var(--code-bg);
    line-height: 1.8;
  }

  pre code {
    padding: 0;
    background: none;
    font-size: var(--text-ui);
  }

  /* On a phone a long command wraps at a space rather than hide past the edge. */
  @media (max-width: 47.99rem) {
    pre {
      padding: var(--space-2);
      white-space: pre-wrap;
    }

    pre code {
      font-size: var(--text-caption);
    }
  }

  .install .intro code {
    white-space: nowrap;
  }

  pre .p {
    color: var(--color-primary);
    user-select: none;
  }

  .small {
    font-size: var(--text-caption);
  }

  .nowrap {
    white-space: nowrap;
  }

  /* Problem */
  .problem {
    display: grid;
    gap: var(--space-2);
    padding-block: 0 var(--space-8);
  }

  /* On the children: a max-width on .problem itself would override .wrap and centre it. */
  .problem > * {
    max-width: 46rem;
  }

  /* How it works */
  .how {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-3);
  }
</style>
