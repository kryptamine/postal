---
import Base from '@app/layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <section class="wrap">
    <h1>Page not found</h1>
    <p class="prose-font muted">
      There is nothing at this address. <a href="/">Go to the home page</a>.
    </p>
  </section>
</Base>

<style>
  section {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6) 0;
  }
</style>
