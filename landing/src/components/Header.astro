---
import { site } from '@app/site';
import Logo from '@app/components/Logo.astro';
---

<header class="wrap">
  <a class="home" href="/" aria-label="Postal, home">
    <Logo height={30} />
  </a>
  <nav aria-label="Main">
    <a href="/#features">Features</a>
    <a href="/#install">Install</a>
    <a href="/privacy/">Privacy</a>
    <a href={site.repo}>GitHub</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .home {
    display: block;
    padding-block: var(--space-1);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-half) var(--space-3);
    font-size: var(--text-caption);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--link-fg);
    text-decoration: underline;
  }

  /* On a phone the nav wraps under the logo: keep both rows tight. */
  @media (max-width: 47.99rem) {
    header {
      row-gap: 0;
      padding-block: var(--space-2) 0;
    }

    nav {
      column-gap: var(--space-2);
      margin-left: calc(var(--space-half) * -1);
    }

    nav a {
      padding-inline: var(--space-half);
    }
  }
</style>
